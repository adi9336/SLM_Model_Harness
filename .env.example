# =====================================================================
# Two-Level Agent Harness Configuration
# =====================================================================

# ---------------------------------------------------------------------
# Option A: Tinker Cloud API (Recommended for Laptops without GPU)
# ---------------------------------------------------------------------
# If set, Level 1 Reasoner connects to Qwen 8B in the cloud via Tinker API,
# while xLAM tool formatting and SQLite execution remain local on your PC.
TINKER_API_KEY=
TINKER_BASE_URL=https://api.tinker.thinkingmachines.ai/v1
TINKER_MODEL=Qwen/Qwen3-8B

# ---------------------------------------------------------------------
# Option B: Local Ollama (Level 2 xLAM Formatter or 100% Local Run)
# ---------------------------------------------------------------------
# Run setup_ollama.bat (Windows) or setup_ollama.sh (Linux/macOS) to auto-install!
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
PRIORITY_MODEL=qwen3:8b
FORMATTER_MODEL=allenporter/xlam:1b
PRIORITY_TEMPERATURE=0.1
FORMATTER_TEMPERATURE=0.0

# ---------------------------------------------------------------------
# Execution Settings
# ---------------------------------------------------------------------
MAX_STEPS=12
DEMO_PACING_DELAY=0.4

