# =====================================================================
# Git Ignore - Two-Level Agent Harness
# =====================================================================

# Environment variables & secrets
.env
.env.local
.env.*.local

# Node.js dependencies & builds
node_modules/
frontend/node_modules/
frontend/dist/
dist/
build/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Python caches and bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
.eggs/

# Database artifacts and runtime logs
*.db
*.db-journal
*.audit.jsonl
*.log

# Task output artifacts
tasks/**/out.csv
tasks/t010_file_organize/processed/*
!tasks/t010_file_organize/processed/.gitkeep

# Operating system files
.DS_Store
Thumbs.db
desktop.ini

# Backup files
*.backup
*.rea.backup

# Local IDEs
.vscode/
.idea/
*.swp
*.swo
